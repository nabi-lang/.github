{
  "$schema": "./pipeline.schema.json",
  "schema": 1,
  "org": "nabi-lang",
  "toolchain": {
    "id": "nabi",
    "repo": "nabi-lang/nabi",
    "targets_file": "release-targets.json",
    "assets": "release-assets/1",
    "release_workflow": "release.yml",
    "environment": "release",
    "supported_series": "latest",
    "smoke": ["ubuntu-24.04", "macos-26", "windows-2022"]
  },
  "components": [
    { "id": "milestone", "kind": "milestone", "repo": "nabi-lang/nabi",
      "on": { "patch": "close", "series": "close" }, "owner": "me" },

    { "id": "nix", "kind": "nix", "repo": "nabi-lang/nabi",
      "on": { "patch": "bump-pr", "series": "bump-pr" },
      "checks": ["ci-nix.yml"], "owner": "me",
      "notes": "scripts/nix.sh {version}; branch nix/{version}; title 'chore(nix): install {version}'; auto-merge through the queue" },

    { "id": "docs", "kind": "content", "repo": "nabi-lang/docs",
      "on": { "patch": "branch", "series": "merge-next+branch" },
      "checks": ["content.yml"],
      "health": [
        { "url": "https://docs.nabi-lang.org/versions.json", "expect": "\"latest\":\"{version}\"", "budget_s": 900 },
        { "url": "https://docs.nabi-lang.org/latest", "expect": "Docs version: v{version}" }
      ], "owner": "me" },

    { "id": "spec", "kind": "content", "repo": "nabi-lang/spec",
      "on": { "patch": "branch+tag", "series": "branch+tag" },
      "checks": ["content.yml"], "owner": "me" },

    { "id": "www", "kind": "content", "repo": "nabi-lang/www",
      "on": { "patch": "roadmap", "series": "roadmap" },
      "checks": ["content.yml"], "owner": "me",
      "notes": "scripts/roadmap-ship.sh {version} (-n to preview, --summary-ko for the Korean entry): the card leaves its section for Shipped in roadmap.md and ko/roadmap.md, with the date and Summary line of the CHANGELOG section and a link to the release notes; a second run changes nothing" },

    { "id": "nabi-lang.org", "kind": "site", "repo": "nabi-lang/nabi-lang.org",
      "on": { "patch": "redeploy", "series": "pin-pr", "kit": "bump-pr" },
      "pin": { "file": "nabi.nabion", "ref": "release" },
      "deploy": { "via": "infra", "workflow": "deploy-nabi-web.yml", "box": "nabi-web" },
      "health": [
        { "url": "https://nabi-lang.org/healthz", "expect": "toolchain {pinned}", "budget_s": 300 },
        { "url": "https://nabi.sh/", "expect": "{version}", "budget_s": 900 }
      ],
      "next": true, "gate": "warn", "owner": "user",
      "notes": "the server lists released docs versions from the vX.Y.Z branches of docs and spec; versions.nabion is for local builds and stays released: [] before 0.1.0. At a series release add it in front (released: [\"0.1\"], patches: { \"0.1\": \"0.1.0\" }); at a patch release move its patches entry" },

    { "id": "playground", "kind": "site", "repo": "nabi-lang/playground.nabi-lang.org",
      "on": { "patch": "redeploy", "series": "pin-pr", "kit": "bump-pr" },
      "pin": { "file": "nabi.nabion", "ref": "release" },
      "deploy": { "via": "infra", "workflow": "deploy-playground.yml", "box": "playground" },
      "health": [
        { "url": "https://playground.nabi-lang.org/api/health", "expect": "nabic {pinned}", "budget_s": 180 },
        { "url": "compile:playground.nabi-lang.org", "expect": "wasm", "budget_s": 120 }
      ],
      "checks": ["ci.yml"], "next": true, "gate": "warn", "owner": "user",
      "notes": "/api/health: ok, then key value lines, among them nabic <release>" },

    { "id": "packages.nabi-lang.org", "kind": "site", "repo": "nabi-lang/packages.nabi-lang.org",
      "on": { "patch": "redeploy", "series": "pin-pr", "kit": "bump-pr" },
      "pin": { "file": "nabi.nabion", "ref": "release" },
      "deploy": { "via": "infra", "workflow": "deploy-packages.yml", "box": "packages" },
      "health": [
        { "url": "https://packages.nabi-lang.org/api/health", "expect": "nabi {pinned}", "budget_s": 180 },
        { "url": "https://packages.nabi-lang.org/api/v1/packages/json", "expect": "Version { version: " }
      ],
      "next": true, "gate": "warn", "owner": "user",
      "notes": "/api/health: ok, nabi <release> and packages <count>, one a line; 503 failing without the package list" },

    { "id": "json", "kind": "package", "repo": "nabi-lang/json",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "toml", "kind": "package", "repo": "nabi-lang/toml",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "http", "kind": "package", "repo": "nabi-lang/http",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "markdown", "kind": "package", "repo": "nabi-lang/markdown",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "regex", "kind": "package", "repo": "nabi-lang/regex",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "linalg", "kind": "package", "repo": "nabi-lang/linalg",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "sparse", "kind": "package", "repo": "nabi-lang/sparse",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "autodiff", "kind": "package", "repo": "nabi-lang/autodiff",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "special", "kind": "package", "repo": "nabi-lang/special",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "signal", "kind": "package", "repo": "nabi-lang/signal",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "units", "kind": "package", "repo": "nabi-lang/units",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "spatial", "kind": "package", "repo": "nabi-lang/spatial",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "csv", "kind": "package", "repo": "nabi-lang/csv",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "table", "kind": "package", "repo": "nabi-lang/table",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "stats", "kind": "package", "repo": "nabi-lang/stats",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "optimize", "kind": "package", "repo": "nabi-lang/optimize",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "interpolate", "kind": "package", "repo": "nabi-lang/interpolate",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "ode", "kind": "package", "repo": "nabi-lang/ode",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "plot", "kind": "package", "repo": "nabi-lang/plot",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me" },
    { "id": "nabi-syntax", "kind": "package", "repo": "nabi-lang/nabi-syntax",
      "on": { "patch": "verify", "series": "pin-pr" },
      "pin": { "file": "nabi.nabion", "ref": "main" },
      "publish": { "block": "publish.yml", "registry": "packages.nabi-lang.org", "environment": "release" },
      "checks": ["ci.yml"], "next": true, "gate": "block", "owner": "me",
      "notes": "the editors pick up a published grammar" },

    { "id": "nabi.vscode", "kind": "editor", "repo": "nabi-lang/nabi.vscode",
      "on": { "syntax": "bump-pr" },
      "checks": ["ci.yml"],
      "health": [
        { "url": "https://open-vsx.org/api/nabi-lang/nabi", "expect": "\"version\":\"{editor_version}\"", "budget_s": 1800 }
      ], "owner": "me",
      "notes": "node scripts/sync-grammar.mjs to nabi-syntax.rev; a v* tag runs publish.yml: VS Code Marketplace and Open VSX by trusted publishing, and the .vsix on the GitHub release" },
    { "id": "nabi.zed", "kind": "editor", "repo": "nabi-lang/nabi.zed",
      "on": { "syntax": "bump-pr" },
      "checks": ["ci.yml"], "owner": "me",
      "notes": "scripts/sync moves nabi-syntax.rev and the grammar revs in extension.toml; a release is a PR to zed-industries/extensions (RELEASING.md)" },
    { "id": "nabi.vim", "kind": "editor", "repo": "nabi-lang/nabi.vim",
      "on": { "syntax": "bump-pr" },
      "checks": ["ci.yml"], "owner": "me",
      "notes": "scripts/sync regenerates queries/ and the keyword lines of syntax/ at nabi-syntax.rev; plugin managers install from main" },

    { "id": "index", "kind": "index", "repo": "nabi-lang/packages-index",
      "on": { "patch": "health", "series": "health" },
      "health": [ { "url": "index-lag:packages.nabi-lang.org", "expect": "0", "budget_s": 600 } ],
      "notes": "config.nabion format 1 (the package line format; nabi and the server read only api); written only by the packages server deploy key; seeded with the std, core and bare Library lines, the 20 packages come in by publish.yml (packages-index README)", "owner": "me" },

    { "id": "web-kit", "kind": "kit", "repo": "nabi-lang/web",
      "on": { "kit": "bump-pr" },
      "notes": "submodule web/ in nabi-lang.org, packages.nabi-lang.org, playground; reusable-content.yml builds nabi_content from the pinned kit", "owner": "user" },

    { "id": "infra", "kind": "infra", "repo": "nabi-lang/infra",
      "on": { "patch": "redeploy", "series": "redeploy" }, "owner": "me" }
  ]
}
